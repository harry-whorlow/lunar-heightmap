---
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const maps = [
  { href: "lunar", icon: "moon.svg", name: "Moon", detail: "LRO LOLA · 1,737 km radius" },
  { href: "mars", icon: "mars.svg", name: "Mars", detail: "MGS MOLA · 3,396 km radius" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/moon.svg`} />
    <meta name="description" content="Interactive, three-dimensional height maps of the Moon and Mars." />
    <meta name="theme-color" content="#090b10" />
    <title>Height maps</title>
  </head>
  <body>
    <main class="index">
      <h1>Height maps</h1>
      <ul class="map-list">
        {maps.map(({ href, icon, name, detail }) => (
          <li>
            <a class="map-link" href={`${base}/${href}/`}>
              <img src={`${base}/${icon}`} alt="" width="40" height="40" />
              <span>
                <strong>{name}</strong>
                <small>{detail}</small>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
