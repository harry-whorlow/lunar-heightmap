---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/moon.svg" />
    <meta
      name="description"
      content="An interactive, three-dimensional study of the lunar surface."
    />
    <meta name="theme-color" content="#090b10" />
    <title>Lunar | height map</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="site-header">
        
      </header>

      <section class="hero" aria-label="Lunar height map">
        <canvas id="moon-canvas"></canvas>
        <div class="controls">
          <label class="control">
            <span>Height exaggeration</span>
            <input id="exaggeration" type="range" min="1" max="30" step="1" value="6" />
            <output id="exaggeration-value" for="exaggeration">10×</output>
          </label>

          <label class="control">
            <span>Distance</span>
            <input id="distance" type="range" min="1.25" max="6" step="0.05" value="1.75" />
            <output id="distance-value" for="distance">1,303 km</output>
          </label>

          <label class="control">
            <span>Contours</span>
            <select id="contours">
              <option value="0">Off</option>
              <option value="0.25" selected>250 m</option>
              <option value="0.5">500 m</option>
              <option value="1" >1 km</option>
              <option value="2">2 km</option>
            </select>
          </label>

          <label class="control">
            <input id="heatmap" type="checkbox" checked />
            <span>Heat map</span>
          </label>
          <label class="control">
            <input id="surface" type="checkbox"  />
            <span>Surface</span>
          </label>
          <label class="control" title="Arrows move · Shift + ↑↓ forward / back">
            <input id="free-cam" type="checkbox" />
            <span>Free cam</span>
          </label>
        </div>
      </section>

      <footer class="site-footer">
      
      </footer>
    </main>

    <script>
      import "../scripts/moon";
    </script>
  </body>
</html>
