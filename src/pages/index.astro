---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/moon.svg" />
    <meta
      name="description"
      content="An interactive, three-dimensional study of the lunar surface."
    />
    <meta name="theme-color" content="#090b10" />
    <title>Lunar | height map</title>
  </head>
  <body>
    <main class="page-shell">
      <header class="site-header">
        
      </header>

      <section class="hero" aria-label="Lunar height map">
        <canvas id="moon-canvas"></canvas>
        <label class="control">
          <span>Height exaggeration</span>
          <input id="exaggeration" type="range" min="1" max="30" step="1" value="10" />
          <output id="exaggeration-value" for="exaggeration">10×</output>
        </label>
      </section>

      <footer class="site-footer">
      
      </footer>
    </main>

    <script>
      import "../scripts/moon";
    </script>
  </body>
</html>
